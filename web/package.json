{
  "name": "hsctikzbench-web",
  "version": "0.1.0",
  "private": true,
  "description": "Web UI for launching, watching and judging HSCTikZBench runs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,vite -c blue,magenta \"tsx watch --clear-screen=false server/main.ts\" \"vite\"",
    "dev:fake": "RUNNER_BENCH_COMMAND='node scripts/fake-bench.mjs' pnpm dev",
    "server": "tsx server/main.ts",
    "build": "vite build && esbuild server/main.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/server.mjs --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\"",
    "start": "NODE_ENV=production node dist/server.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@radix-ui/themes": "^3",
    "@t3-oss/env-core": "^0.13.11",
    "hono": "^4.13.5",
    "hsctikzbench-cli": "workspace:*",
    "next-themes": "^0.4.6",
    "react": "^19",
    "react-dom": "^19",
    "tsx": "^4.23.13",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "concurrently": "^9",
    "typescript": "^7",
    "vite": "^8"
  }
}
